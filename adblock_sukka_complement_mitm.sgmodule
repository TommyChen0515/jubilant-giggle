#!name=AdBlock Complement (Sukka) - URL-REGEX MITM
#!desc=Appends 20 MITM hostname entries derived from the 11 URL-REGEX rules in adblock_sukka_complement_extra.list, so those rules can also match HTTPS. Requires a generated and trusted MITM CA certificate (Surge -> MitM -> Generate CA). Without the certificate this module does nothing, and certificate-pinning apps may fail to connect.
#!category=Ad Blocking

[MITM]
hostname = %APPEND% *.beacon.qq.com, *.cdn-1rtb.caiyunapp.com, *.d.sina.com, *.d.sinaimg.cn, *.d.tuisong.baidu.com, *.gdt.qq.com, *.goblin.hupu.com, *.l.qq.com, *.sina.com.cn, *.update.pan.baidu.com, beacon.qq.com, cdn-1rtb.caiyunapp.com, d.sina.com, d.sinaimg.cn, d.tuisong.baidu.com, gdt.qq.com, goblin.hupu.com, l.qq.com, sina.com.cn, update.pan.baidu.com
